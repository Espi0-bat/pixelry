# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL pública do app — destino dos e-mails de recuperação de senha.
# Sem isto, usa a origem atual do navegador (ok em dev). Defina em produção.
VITE_APP_URL=https://www.pixelry.com.br

# Medição (opcional). Vazio = nada carrega e nenhuma requisição sai.
# GA4: ID de medição do fluxo de dados da web, no formato G-XXXXXXXXXX.
# Meta: ID do pixel no Gerenciador de Eventos, só números.
# Os dois só sobem depois que o visitante aceita os cookies correspondentes:
# GA4 depende de "analytics", Meta Pixel depende de "marketing".
VITE_GA4_ID=
VITE_META_PIXEL_ID=

# MercadoPago — configurar apenas nos Secrets da Edge Function no Supabase Dashboard
# (NUNCA colocar no .env do Vite — ficaria exposto no navegador)
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
# MERCADOPAGO_WEBHOOK_SECRET=sua-string-secreta-aqui
# VITE_APP_URL=https://www.pixelry.com.br
